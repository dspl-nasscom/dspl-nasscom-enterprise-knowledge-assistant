# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini           # gemini | ollama | openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings & Reranker ──────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base
TOP_K_RETRIEVE=20
TOP_N_RERANK=5
CONFIDENCE_THRESHOLD=0.4

# ── Google Cloud ───────────────────────────────────────────────────────────────
# GCS bucket where uploaded documents are stored for URL citation
GCS_BUCKET_NAME=your-bucket-name
# GCP project ID for Firestore (ingest jobs, document records, query logs)
FIRESTORE_PROJECT=your-gcp-project-id
# Path to service-account key JSON for signed URL generation.
# Leave empty on Cloud Run / GKE (Workload Identity used automatically).
# Set locally if gcloud ADC is a user account (not a service account).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Vector Store ───────────────────────────────────────────────────────────────
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_copilot
VECTOR_STORE_PATH=data/vector_store

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_ENV=development          # development | production
LOG_LEVEL=info
